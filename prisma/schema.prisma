generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "sqlite"
}

model Profile {
    id                  String      @id @default(cuid())
    name                String
    age                 Int
    photo               String
    bio                 String
    interests           String
    cityOrCollege       String      @map("city_or_college")
    likedLoggedInUser   Boolean     @default(false)
    createdAt           DateTime    @default(now())
}

model Swipe {
    id                  String      @id @default(cuid())
    userId              String
    targetProfileId     String
    action              String
    createdAt           DateTime    @default(now())

    @@unique([userId, targetProfileId])
}